# Database (hosted Postgres - Neon, Supabase, or Netlify DB all work)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# File storage - Cloudflare R2 (S3-compatible). Create two buckets: one public, one private.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="xxx"
S3_SECRET_ACCESS_KEY="xxx"
S3_BUCKET_PUBLIC="templatetreasury-public"
S3_BUCKET_PRIVATE="templatetreasury-private"
S3_PUBLIC_URL_BASE="https://pub-xxxx.r2.dev"   # or your custom domain connected to the public bucket

# App
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Admin auth (the ONLY credentials that can log in to the secret admin page)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="$2a$10$replace_with_bcrypt_hash"   # generate with scripts/hash-password.js
ADMIN_SESSION_SECRET="a-long-random-string-min-32-chars"

# The secret admin URL segment. Change this to something only you know.
# Admin login lives at: /admin-<ADMIN_SLUG>  e.g. /admin-x7k9p2
ADMIN_SLUG="x7k9p2q8"

# Stripe (international cards / PayPal via Stripe Checkout)
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxx"

# Razorpay (UPI - Google Pay / PhonePe / Paytm, Indian cards, netbanking)
RAZORPAY_KEY_ID="rzp_live_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"

# Email delivery (order confirmation + download link)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="re_xxx"
EMAIL_FROM="Your Store <orders@yourdomain.com>"

# Download link security
DOWNLOAD_LINK_SECRET="another-long-random-string"
